# 衣先知 Android 后端。复制为 server/.env 后填写，不提交到版本库。
# 生产必须设置 NODE_ENV=production，且 AUTH_SECRET 至少24字符。
NODE_ENV=production
PORT=8394
AUTH_SECRET=
DEMO_MODE=false
# 默认为 server/data；Docker 已配置持久卷，不要改成临时目录。
# DATA_DIR=

# 真实 AI：识别/质检/推荐/试穿经 OpenRouter；平铺图经百炼。
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com

# 邮箱验证码（阿里云 DirectMail）：必须使用你已验证的发信账号。
DM_ACCESS_KEY_ID=
DM_ACCESS_KEY_SECRET=
DM_ACCOUNT=
DM_ENDPOINT=https://dm.aliyuncs.com/

# 额外允许的浏览器 origin，逗号分隔。APK https://localhost 已内置允许。
ALLOWED_ORIGINS=
MEDIA_QUOTA_MB=200
QUOTA_SPLIT_PER_DAY=5
QUOTA_TRYON_PER_DAY=20
QUOTA_VALIDATE_PER_DAY=30
QUOTA_RECOMMEND_PER_DAY=50
ADMIN_TOKEN=
